# 运行环境
NODE_ENV=development

# API 服务监听地址
HOST=127.0.0.1
PORT=3009

# 前端开发服务器地址，用于 CORS
CLIENT_ORIGIN=http://127.0.0.1:5177

# 生产模式下由后端托管前端构建产物（需先 pnpm build）
SERVE_CLIENT=true

# PostgreSQL 连接地址
DATABASE_URL=postgres://vault:vault_dev@localhost:5633/vault_page?sslmode=disable

# Redis 连接地址
REDIS_URL=redis://localhost:6379

# JWT 鉴权配置；生产环境必须替换 JWT_SECRET
JWT_SECRET=dev-secret
# access 有效期；refresh 默认 720h（30 天）不变，受 DB session 控制可主动吊销
JWT_EXPIRY=12h
JWT_REFRESH_EXPIRY=720h

# 默认测试邀请码；非生产环境不配置时默认使用 blogus-dev-invite，生产环境仅显式配置时生效
BLOGUS_DEFAULT_INVITE_CODE=blogus-dev-invite

# 开发便捷登录；生产环境强制关闭
BLOGUS_ENABLE_DEV_LOGIN=true

# 上传存储后端：local 为默认本地磁盘，minio 为 S3 兼容存储
STORAGE_DRIVER=local

# 本地上传目录和公开访问路径，仅 STORAGE_DRIVER=local 时使用
UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_PATH=/uploads

# MinIO 配置，仅 STORAGE_DRIVER=minio 时使用
MINIO_ENDPOINT=localhost:9010
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=vault-files
MINIO_USE_SSL=false

# 上传限制
UPLOAD_MAX_SIZE_MB=512
UPLOAD_CHUNK_SIZE_MB=5

# Docker Compose 数据目录，用于 PostgreSQL、Redis、可选 MinIO
BLOGUS_DATA_DIR=./.data
